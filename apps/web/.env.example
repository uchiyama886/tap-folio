# Supabase Dashboard > Settings > API から取得
# Project URL (https://<project-ref>.supabase.co の形式。キーではなくURLそのもの)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_... / 旧anon key相当。ブラウザに公開してよい鍵)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 注意: Secret key (sb_secret_... / 旧service_role key相当) は絶対にNEXT_PUBLIC_接頭辞を付けないこと。
# RLSを無視する管理者権限の鍵のため、ブラウザに公開すると誰でもDB全体にアクセスできてしまう。
# サーバー専用処理で必要になった場合のみ SUPABASE_SECRET_KEY として追加し、Route Handler等サーバーサイドでのみ使用する。

# Claude API キー（サーバー専用。/api/analyze-photo の画像解析で使用）
# https://console.anthropic.com/ で発行。NEXT_PUBLIC_ を付けないこと（クライアントに露出させない）。
ANTHROPIC_API_KEY=
